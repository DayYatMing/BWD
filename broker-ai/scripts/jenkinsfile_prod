#!/usr/bin/env groovy

def SendEmail(stageName, status, hosts, type, error) {
    def url = "https://jenkins.local.bw-digital.com/job/${env.JOB_NAME}/${env.BUILD_NUMBER}/"
    def url_console = url + "console"
    def to = "oyip@bw-digital.com, niuday@bw-digital.com"
    def str = ""

    if(error != ""){
        str = "<p>Error: " + error + "</p>" +
            "<p>Check console full-log at <a href='${url_console}'>${env.JOB_NAME} [#${env.BUILD_NUMBER}]</a></p>"
    }

    emailext (
        recipientProviders: [[$class: 'DevelopersRecipientProvider']],
        subject: "Jenkins Pipeline - ${env.JOB_NAME} [#${env.BUILD_NUMBER}]",
        body: "<p>Stage: " + stageName + "</p>" +
            "<p>Status: <b>" + status.toUpperCase() + "</b></p>" +
            "<p>Job: ${env.JOB_NAME} [#${env.BUILD_NUMBER}]</p>" +
            "<p>Hosts: " + hosts + "</p>" +
            "<p>Type: " + type + "</p>" +
            str ,
        to: "${to}"
    )
}

node {
    def hosts = []
    def deploymentType = "deployment"
    def version = "v1.0.0"
    def appPort = "3100"
    def sshPort = "404"

    stage('Preliminary settings') {
        if (params.Host == 'All') {
            hosts = ['10.7.1.4','10.2.1.4']
        } else {
            hosts = [params.Host]
        }
        deploymentType = params.Deployment
        echo "Host: ${hosts}"
        echo "Deployment: ${deploymentType}"

        SendEmail(env.STAGE_NAME, "Started", hosts, deploymentType, "")

        try {
            checkout scm
            sh "whoami"

        }catch (err) {
            SendEmail(env.STAGE_NAME, "Failed", hosts, deploymentType, err)
            error("Process stopped due to failure - " + err)
        }
    }

    stage('Snyk scanning') {
        try {
            echo "skip snyk scanning for broker service!"
        } catch (err) {
            SendEmail(env.STAGE_NAME, "Failed", hosts, deploymentType, err)
            error("Process stopped due to failure - " + err)
        }
    }

    stage('Docker packaging') {
        try {
            sh "docker build --build-arg PROFILE=prod . -t bwdigital/brokerai:${version} -f Dockerfile"
        } catch (err) {
            SendEmail(env.STAGE_NAME, "Failed", hosts, deploymentType, err)
            error("Process stopped due to failure - " + err)
        }
    }

    stage('Configuring') {
        if(deploymentType != 'RESTART') {
            script {
                for (host in hosts) {
                    echo "Processing host: ${host}"
                    try {
                        sh "docker save -o brokerai.tar  bwdigital/brokerai:${version}"
                    } catch (ignore) {
                    }

                    try {
                        sh "ssh -p ${sshPort} ${host} 'docker-compose -f /docker-files/brokerai-volume/docker-compose_Prod.yml down'"
                    } catch (ignore) {
                    }

                    if (deploymentType == 'FRESH_DEPLOYMENT') {
                        try {
                            sh "ssh -p ${sshPort} ${host} 'rm -rf /docker-files/brokerai-volume/*"
                        } catch (ignore) {
                        }
                    }

                    try {
                        sh "ssh -p ${sshPort} ${host} 'mkdir -p /docker-files/brokerai-volume/config /docker-files/brokerai-volume/data /docker-files/brokerai-volume/logs'"
                    } catch (ignore) {
                    }

                    try {
                        sh "scp -P ${sshPort} ./scripts/docker-compose_Prod.yml  brokerai.tar  ${host}:/docker-files/brokerai-volume/"
                    } catch (ignore) {
                    }

                    try {
                        sh "ssh -p ${sshPort} ${host} 'docker network create prod_network'"
                    } catch (ignored) {
                    }

                    try {
                        sh "ssh -p ${sshPort} ${host} 'docker load -i /docker-files/brokerai-volume/brokerai.tar'"
                    } catch (ignore) {
                    }
                }
            }
        }
        try {
            sh "docker images -f 'dangling=true' -q | xargs -r docker rmi"
        } catch (ignore) {
        }
    }

    stage('Server starting') {
        script {
            for (host in hosts) {
                echo "Starting service on host: ${host}"
                try {
                    sh "ssh -p ${sshPort} ${host} 'docker-compose -f /docker-files/brokerai-volume/docker-compose_Prod.yml down'"
                } catch (ignore) {
                }

                try {
                    sh "ssh -p ${sshPort} ${host} 'docker-compose -f /docker-files/brokerai-volume/docker-compose_Prod.yml up -d'"
                } catch (ignore) {
                }

                try {
                    sh "rm -rf /var/lib/jenkins/workspace/Docker_Broker_AI_Deploy_Prod/brokerai.tar"
                    sh "ssh -p ${sshPort} ${host} 'rm -rf  /docker-files/brokerai-volume/brokerai.tar'"
                } catch (ignore) {
                }

                try {
                    sh "ssh -p ${sshPort} ${host} 'docker images -f \"dangling=true\" -q | xargs -r docker rmi'"
                } catch (ignore) {
                }
            }
        }
    }


    stage('Deployment checking') {
        for (host in hosts) {
            sleep 300
            try {
                sh "ssh -p ${sshPort} ${host} curl localhost:${appPort}"
            } catch (err) {
                SendEmail(env.STAGE_NAME, "Failed", hosts, deploymentType, err)
                error("Process stopped due to failure - " + err)
            }
        }

        SendEmail(env.STAGE_NAME, "Completed", hosts, deploymentType, "")
    }
}
