        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here

tmp_date_timestart = new Date(date_to_start.substring(0,4),parseInt(date_to_start.substring(5,7))-1,date_to_start.substring(8));
tmp_date_timeend = new Date(date_to_end.substring(0,4),parseInt(date_to_end.substring(5,7))-1,date_to_end.substring(8));

date_timestart.setDate(tmp_date_timestart.getDate());
date_timestart.setMonth(tmp_date_timestart.getMonth());
date_timestart.setYear(tmp_date_timestart.getYear());

date_timeend.setDate(tmp_date_timeend.getDate());
date_timeend.setMonth(tmp_date_timeend.getMonth());
date_timeend.setYear(tmp_date_timeend.getYear());
</jsScript_script>
      </jsScript>
    </jsScripts>
