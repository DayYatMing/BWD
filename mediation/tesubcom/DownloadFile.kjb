  <entries>
    <entry>
      <name>START</name>
      <description/>
      <type>SPECIAL</type>
      <start>Y</start>
      <dummy>N</dummy>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>80</xloc>
      <yloc>128</yloc>
    </entry>
    <entry>
      <name>Get och files 1</name>
      <description/>
      <type>FTP</type>
      <port>${TARGET_FTP_SERVER_PORT}</port>
      <servername>${TARGET_FTP_SERVER_IP}</servername>
      <username>${TARGET_FTP_SERVER_USERNAME}</username>
      <password>${TARGET_FTP_SERVER_PASSWORD}</password>
      <ftpdirectory>${TARGET_FTP_SERVER_DIRECTORY}/${FOLDER_NAME}</ftpdirectory>
      <targetdirectory>${TARGET_LOCAL_FILE_DIRECTORY}/${FOLDER_NAME}</targetdirectory>
      <wildcard>.*\.csv$</wildcard>
      <binary>N</binary>
      <timeout>0</timeout>
      <remove>N</remove>
      <only_new>N</only_new>
      <active>N</active>
      <control_encoding>ISO-8859-1</control_encoding>
      <movefiles>Y</movefiles>
      <movetodirectory>${TARGET_FTP_SERVER_DIRECTORY}/${FOLDER_NAME}/old</movetodirectory>
      <adddate>N</adddate>
      <addtime>N</addtime>
      <SpecifyFormat>N</SpecifyFormat>
      <date_time_format/>
      <AddDateBeforeExtension>N</AddDateBeforeExtension>
      <isaddresult>Y</isaddresult>
      <createmovefolder>Y</createmovefolder>
      <proxy_host/>
      <proxy_port/>
      <proxy_username/>
      <proxy_password>Encrypted </proxy_password>
      <socksproxy_host/>
      <socksproxy_port>1080</socksproxy_port>
      <socksproxy_username/>
      <socksproxy_password>Encrypted </socksproxy_password>
      <ifFileExists>ifFileExistsSkip</ifFileExists>
      <nr_limit>10</nr_limit>
      <success_condition>success_if_no_errors</success_condition>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>1</nr>
      <xloc>336</xloc>
      <yloc>128</yloc>
    </entry>
    <entry>
      <name>Write To Log 2</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <logmessage>&lt;/br>&lt;font color='green'>File successfully downloaded from folder ${FOLDER_NAME} on ${TARGET_FTP_SERVER_IP}&lt;/font></logmessage>
      <loglevel>Basic</loglevel>
      <logsubject>----------------- In Dlownload file --------------------------------------</logsubject>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>512</xloc>
      <yloc>272</yloc>
    </entry>
    <entry>
      <name>Write To Log</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <logmessage>File download failed for folder ${FOLDER_NAME} on IP ${TARGET_FTP_SERVER_IP} - FTP error</logmessage>
      <loglevel>Basic</loglevel>
      <logsubject>----------------- In Dlownload file --------------------------------------</logsubject>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>336</xloc>
      <yloc>272</yloc>
    </entry>
    <entry>
      <name>Check if a folder is empty</name>
      <description/>
      <type>FOLDER_IS_EMPTY</type>
      <foldername>${TARGET_LOCAL_FILE_DIRECTORY}/${FOLDER_NAME}</foldername>
      <include_subfolders>Y</include_subfolders>
      <specify_wildcard>N</specify_wildcard>
      <wildcard/>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>512</xloc>
      <yloc>128</yloc>
    </entry>
    <entry>
      <name>Write To Log 3</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <logmessage>&lt;/br>&lt;font color='red'>File download failed for folder ${FOLDER_NAME} on IP ${TARGET_FTP_SERVER_IP} - File not found&lt;/font></logmessage>
      <loglevel>Basic</loglevel>
      <logsubject/>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>672</xloc>
      <yloc>128</yloc>
    </entry>
    <entry>
      <name>ftp log error</name>
      <description/>
      <type>WRITE_TO_FILE</type>
      <filename>${Internal.Entry.Current.Directory}/${TARGET_FTP_LOGS_DIRECTORY}</filename>
      <createParentFolder>N</createParentFolder>
      <appendFile>Y</appendFile>
      <content>&lt;/br>&lt;font color='red'>File download failed for folder ${FOLDER_NAME} on IP ${TARGET_FTP_SERVER_IP} - FTP error&lt;/font></content>
      <encoding/>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>336</xloc>
      <yloc>416</yloc>
    </entry>
    <entry>
      <name>ftp log success</name>
      <description/>
      <type>WRITE_TO_FILE</type>
      <filename>${Internal.Entry.Current.Directory}/${TARGET_FTP_LOGS_DIRECTORY}</filename>
      <createParentFolder>N</createParentFolder>
      <appendFile>Y</appendFile>
      <content>&lt;/br>&lt;font color='green'>File successfully downloaded from folder ${FOLDER_NAME} on ${TARGET_FTP_SERVER_IP}&lt;/font></content>
      <encoding/>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>512</xloc>
      <yloc>416</yloc>
    </entry>
    <entry>
      <name>ftp log file not found</name>
      <description/>
      <type>WRITE_TO_FILE</type>
      <filename>${Internal.Entry.Current.Directory}/${TARGET_FTP_LOGS_DIRECTORY}</filename>
      <createParentFolder>N</createParentFolder>
      <appendFile>Y</appendFile>
      <content>&lt;/br>&lt;font color='red'>File download failed for folder ${FOLDER_NAME} on IP ${TARGET_FTP_SERVER_IP} - File not found&lt;/font></content>
      <encoding/>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>816</xloc>
      <yloc>128</yloc>
    </entry>
    <entry>
      <name>ftp log starting</name>
      <description/>
      <type>WRITE_TO_FILE</type>
      <filename>${Internal.Entry.Current.Directory}/${TARGET_FTP_LOGS_DIRECTORY}</filename>
      <createParentFolder>N</createParentFolder>
      <appendFile>Y</appendFile>
      <content>&lt;/br>&lt;/br>Starting transformation for folder ${FOLDER_NAME} on IP ${TARGET_FTP_SERVER_IP}</content>
      <encoding/>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>208</xloc>
      <yloc>128</yloc>
    </entry>
  </entries>
  <hops>
    <hop>
      <from>Get och files 1</from>
