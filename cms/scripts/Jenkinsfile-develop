#!/usr/bin/env groovy

def SendEmail(stageName, status, hosts, type, error) {
    def url = "https://jenkins.local.bw-digital.com/job/${env.JOB_NAME}/${env.BUILD_NUMBER}/"
    def url_console = url + "console"
    def to = "oyip@bw-digital.com, niuday@bw-digital.com"
    def str = ""

    if(error != ""){
        str = "<p>Error: " + error + "</p>" +
            "<p>Check console full-log at <a href='${url_console}'>${env.JOB_NAME} [#${env.BUILD_NUMBER}]</a></p>"
    }

    emailext (
        recipientProviders: [[$class: 'DevelopersRecipientProvider']],
        subject: "Jenkins Pipeline - ${env.JOB_NAME} [#${env.BUILD_NUMBER}]",
        body: "<p>Stage: " + stageName + "</p>" +
            "<p>Status: <b>" + status.toUpperCase() + "</b></p>" +
            "<p>Job: ${env.JOB_NAME} [#${env.BUILD_NUMBER}]</p>" +
            "<p>Hosts: " + hosts + "</p>" +
            "<p>Type: " + type + "</p>" +
            str ,
        to: "${to}"
    )
}

node {
    def hosts = []
    def deploymentType = "deployment"
    def version = "v1.0.0"
    def appPort = "9006"
    def sshPort = "404"

    stage('Preliminary settings') {
        if (params.Host == 'All') {
            hosts = ['10.10.1.4', '10.2.1.5']
        } else {
            hosts = [params.Host]
        }
        deploymentType = params.Deployment
        echo "Host: ${hosts}"
        echo "Deployment: ${deploymentType}"

        SendEmail(env.STAGE_NAME, "Started", hosts, deploymentType, "")

        try {
            checkout scm

            script {
                env.JAVA_HOME = "/var/lib/jenkins/tools/jdk-17.0.12"
                env.PATH = "${env.JAVA_HOME}/bin:${env.PATH}:/var/lib/jenkins/tools/node-v22.15.0-linux-x64/bin"
            }
            sh "java -version"
            sh "node -v"
            sh "chmod +x gradlew"
            sh "chmod +x npmw"
        } catch (err) {
            SendEmail(env.STAGE_NAME, "Failed", hosts, deploymentType, err)
            error("Process stopped due to failure - " + err)
        }
    }

    stage('Snyk scanning') {
        try {
            echo "skip snyk scanning for pre prod environment."
        } catch (err) {
            SendEmail(env.STAGE_NAME, "Failed", hosts, deploymentType, err)
            error("Process stopped due to failure - " + err)
        }
    }

    stage('Docker packaging') {
        try {
            sh "rm -rf node_modules package-lock.json"
            sh "./npmw cache clean --force"
            sh "rm -rf /var/lib/jenkins/.npm/_cacache"
            sh "./npmw install"
            sh "./gradlew -Pdev -Pwar clean bootWar -x test --no-daemon"
            archiveArtifacts artifacts: '**/build/libs/*.war', fingerprint: true

            sh "docker build --build-arg PROFILE=preprod . -t bwdigital/cms:${version} -f src/main/docker/Dockerfile"
        } catch (err) {
            SendEmail(env.STAGE_NAME, "Failed", hosts, deploymentType, err)
            error("Process stopped due to failure - " + err)
        }
    }

    stage('Configuring') {
        if(deploymentType != 'RESTART') {
            script {
                for (host in hosts) {
                    echo "Processing host: ${host}"

                    try {
                        sh "docker save -o cms.tar  bwdigital/cms:${version}"
                    } catch (ignore) {
                    }

                    try {
                        sh "ssh -p ${sshPort} ${host} 'docker-compose -f /docker-files/cms-volume/docker-compose_PreProd.yml down'"
                    } catch (ignore) {
                    }

                    if (deploymentType == 'FRESH_DEPLOYMENT') {
                        try {
                            sh "ssh -p ${sshPort} ${host} 'rm -rf /docker-files/cms-volume/*"
                        } catch (ignore) {
                        }
                    }

                    try {
                        sh "ssh -p ${sshPort} ${host} 'mkdir -p /docker-files/cms-volume/config /docker-files/cms-volume/data /docker-files/cms-volume/logs'"
                    } catch (ignore) {
                    }

                    try {
                        sh "scp -P ${sshPort} ./src/main/docker/docker-compose_PreProd.yml  cms.tar  ${host}:/docker-files/cms-volume/"
                    } catch (ignore) {
                    }

                    try {
                        sh "ssh -p 404 ${host} 'docker network create preprod_network'"
                    } catch (ignore) {
                    }

                    try {
                        sh "ssh -p 404 ${host} 'docker load -i /docker-files/cms-volume/cms.tar'"
                    } catch (ignore) {
                    }
                }
            }
        }

        try {
            sh "docker images -f 'dangling=true' -q | xargs -r docker rmi"
        } catch (ignore) {
        }
    }

    stage('Server starting') {
        script {
            for (host in hosts) {
                echo "Starting service on host: ${host}"

                try {
                    sh "ssh -p ${sshPort} ${host} 'docker-compose -f /docker-files/cms-volume/docker-compose_PreProd.yml down'"
                } catch (ignore) {
                }

                try {
                    sh "ssh -p ${sshPort} ${host} 'docker-compose -f /docker-files/cms-volume/docker-compose_PreProd.yml up -d'"
                } catch (ignore) {
                }

                try {
                    sh "ssh -p ${sshPort} ${host} 'rm -rf  /docker-files/cms-volume/cms.tar'"
                } catch (ignore) {
                }

                try {
                    sh "ssh -p ${sshPort} ${host} 'docker images -f \"dangling=true\" -q | xargs -r docker rmi'"
                } catch (ignore) {
                }
            }
        }
    }

    stage('Deployment checking') {
        for (host in hosts) {
            sleep 300

            try {
                sh "ssh -p ${sshPort} ${host} curl localhost:${appPort}"
            } catch (err) {
                SendEmail(env.STAGE_NAME, "Failed", hosts, deploymentType, err)
                error("Process stopped due to failure - " + err)
            }
        }

        SendEmail(env.STAGE_NAME, "Completed", hosts, deploymentType, "")
    }
}
