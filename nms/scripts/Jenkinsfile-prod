#!/usr/bin/env groovy

def SendEmail(stageName, status, hosts, type, error) {
    def url = "https://jenkins.local.bw-digital.com/job/${env.JOB_NAME}/${env.BUILD_NUMBER}/"
    def url_console = url + "console"
    def to = "oyip@bw-digital.com"
    def str = ""

    if(error != ""){
        str = "<p>Error: " + error + "</p>" +
            "<p>Check console full-log at <a href='${url_console}'>${env.JOB_NAME} [#${env.BUILD_NUMBER}]</a></p>"
    }

    emailext (
        recipientProviders: [[$class: 'DevelopersRecipientProvider']],
        subject: "Jenkins Pipeline - ${env.JOB_NAME} [#${env.BUILD_NUMBER}]",
        body: "<p>Stage: " + stageName + "</p>" +
            "<p>Status: <b>" + status.toUpperCase() + "</b></p>" +
            "<p>Job: ${env.JOB_NAME} [#${env.BUILD_NUMBER}]</p>" +
            "<p>Hosts: " + hosts + "</p>" +
            "<p>Type: " + type + "</p>" +
            str ,
        to: "${to}"
    )
}

node {
    def hosts = []
    def deploymentType = "deployment"
    def version = "v1.0.0"
    def appPort = "9005"
    def sshPort = "404"

    stage('Preliminary settings') {
      if (params.Host == 'All') {
          hosts = ['10.7.1.4','10.2.1.4']
      } else {
          hosts = [params.Host]
      }
      deploymentType = params.Deployment
      echo "Host: ${hosts}"
      echo "Deployment: ${deploymentType}"

      SendEmail(env.STAGE_NAME, "Started", hosts, deploymentType, "")

      try {
        checkout scm
        script {
          env.JAVA_HOME = "/var/lib/jenkins/tools/jdk-17.0.12"
          env.PATH = "${env.JAVA_HOME}/bin:/var/lib/jenkins/tools/node-v20.19.4-linux-x64/bin:${env.PATH}"
        }
        sh "java -version"
        sh "node -v"
        sh "npm -v"
        sh "chmod +x gradlew"
        sh "chmod +x npmw"
        sh "chmod 777 -R /var/lib/jenkins/workspace/Docker_NMS_Deploy_Prod/"
      } catch (err) {
        SendEmail(env.STAGE_NAME, "Failed", hosts, deploymentType, err)
        error("Process stopped due to failure - " + err)
      }
    }

    stage('Snyk scanning') {
      try {
        sh "chmod +x ./snyk/snyk-linux"
        sh "./snyk/snyk-linux auth 06388db3-9f85-4263-bf00-946b7ef8fa4f"
        sh "./snyk/snyk-linux test --all-projects --severity-threshold=high || true"
        sh "./snyk/snyk-linux monitor --remote-repo-url='bwdigital-app/NMS' --all-projects --severity-threshold=high"
      } catch (err) {
      }
    }

  stage('Docker packaging') {
    try {
      sh "./npmw install"
      sh "./gradlew -Pprod -Pwar clean bootWar"
      archiveArtifacts artifacts: '**/build/libs/*.war', fingerprint: true

      sh "docker build --build-arg PROFILE=prod . -t bwdigital/nms:${version} -f src/main/docker/Dockerfile"
    } catch (err) {
      SendEmail(env.STAGE_NAME, "Failed", hosts, deploymentType, err)
      error("Process stopped due to failure - " + err)
    }
  }

  stage('Configuring') {
    if(deploymentType != 'RESTART') {
      script {
        for (host in hosts) {
          echo "Processing host: ${host}"

          try {
            sh "docker save -o nms.tar  bwdigital/nms:${version}"
          } catch (ignore) {
          }

          try {
            sh "ssh -p ${sshPort} ${host} 'docker-compose -f /docker-files/nms-volume/docker-compose_Prod.yml down'"
          } catch (ignore) {
          }

          if (deploymentType == 'FRESH_DEPLOYMENT') {
            try {
              sh "ssh -p ${sshPort} ${host} 'rm -rf /docker-files/nms-volume/*"
            } catch (ignore) {
            }
          }

          try {
            sh "ssh -p ${sshPort} ${host} 'mkdir -p /docker-files/nms-volume/config /docker-files/nms-volume/data /docker-files/nms-volume/logs'"
          } catch (ignore) {
          }

          try {
            sh "scp -P ${sshPort} ./src/main/docker/docker-compose_Prod.yml  nms.tar  ${host}:/docker-files/nms-volume/"
          } catch (ignore) {
          }

          try {
            sh "ssh -p 404 ${host} 'docker network create prod_network'"
          } catch (ignore) {
          }

          try {
            sh "ssh -p 404 ${host} 'docker load -i /docker-files/nms-volume/nms.tar'"
          } catch (ignore) {
          }
        }
      }
    }

    try {
      sh "docker images -f 'dangling=true' -q | xargs -r docker rmi"
    } catch (ignore) {
    }
  }

  stage('Server starting') {
    script {
      for (host in hosts) {
        echo "Starting service on host: ${host}"

        try {
          sh "ssh -p ${sshPort} ${host} 'docker-compose -f /docker-files/nms-volume/docker-compose_Prod.yml down'"
        } catch (ignore) {
        }

        try {
          sh "ssh -p ${sshPort} ${host} 'docker-compose -f /docker-files/nms-volume/docker-compose_Prod.yml up -d'"
        } catch (ignore) {
        }

        try {
          sh "ssh -p ${sshPort} ${host} 'rm -rf  /docker-files/nms-volume/nms.tar'"
        } catch (ignore) {
        }

        try {
          sh "ssh -p ${sshPort} ${host} 'docker images -f \"dangling=true\" -q | xargs -r docker rmi'"
        } catch (ignore) {
        }
      }
    }
  }

  stage('Deployment checking') {
    for (host in hosts) {
      sleep 300

      try {
        sh "ssh -p ${sshPort} ${host} curl localhost:${appPort}"
      } catch (err) {
        SendEmail(env.STAGE_NAME, "Failed", hosts, deploymentType, err)
        error("Process stopped due to failure - " + err)
      }
    }

    SendEmail(env.STAGE_NAME, "Completed", hosts, deploymentType, "")
  }
}
